# Variaveis do site (Worker / preview). SMTP fica em backend/.env — ver backend/.env.example

INSTITUTIONAL_VIDEO_URL=https://cdn.seudominio.com/videos/institucional_full.mp4

# Em Docker/Dokploy, o entrypoint regrava dist/server/.dev.vars na subida do container
# com as variaveis acima (para video e /api/public-config).

# Opcional: hosts extras para `vite preview` (separados por virgula)
# PREVIEW_ALLOWED_HOSTS=outro.dominio.com,preview.local
