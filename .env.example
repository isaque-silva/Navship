SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_USER=comercial@navship.com.br
SMTP_PASS=sua-senha-ou-app-password
SMTP_SECURE=false
SMTP_START_TLS=true
SMTP_FROM=comercial@navship.com.br
SMTP_FROM_NAME=Site NavShip
CONTACT_TO_EMAIL=comercial@navship.com.br
INSTITUTIONAL_VIDEO_URL=https://cdn.seudominio.com/videos/institucional_full.mp4

# Em Docker/Dokploy, defina as variaveis acima no painel do servico.
# O entrypoint regrava dist/server/.dev.vars na subida do container para o
# preview do Cloudflare Workers enxergar SMTP e demais segredos em runtime.

# Opcional: hosts extras para `vite preview` (separados por virgula)
# PREVIEW_ALLOWED_HOSTS=outro.dominio.com,preview.local
