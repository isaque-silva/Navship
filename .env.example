# === Porta publica do nginx (mapeamento host:container 80) ===
# Padrao no docker-compose e 8080 (a 3000 costuma estar ocupada no servidor).
# NAVSHIP_GATEWAY_PORT=3000

# === Site (navship-app) ===
INSTITUTIONAL_VIDEO_URL=https://cdn.seudominio.com/videos/institucional_full.mp4

# === E-mail (navship-backend) — obrigatorio para o formulario de contato ===
# No Dokploy: adicione estas chaves em Environment (mesmos nomes). Nao e preciso backend/.env no repo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
SMTP_SECURE=false
SMTP_START_TLS=true
SMTP_FROM=seu-email@gmail.com
SMTP_FROM_NAME=Site NavShip
CONTACT_TO_EMAIL=comercial@navship.com.br

# Opcional
# BACKEND_PORT=4000
# CONTACT_DIAGNOSTICS=1

# O entrypoint do app regrava dist/server/.dev.vars com INSTITUTIONAL_VIDEO_URL em runtime.

# Opcional: hosts extras para `vite preview` (separados por virgula)
# PREVIEW_ALLOWED_HOSTS=outro.dominio.com,preview.local
