# Uso local (npm run start na pasta backend): copie para backend/.env
#
# Docker Compose usa variaveis na raiz do projeto (ver /.env.example) ou o painel
# Environment do Dokploy — nao e obrigatorio ter backend/.env no servidor.

PORT=4000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
SMTP_SECURE=false
SMTP_START_TLS=true
SMTP_FROM=seu-email@gmail.com
SMTP_FROM_NAME=Site NavShip
CONTACT_TO_EMAIL=comercial@navship.com.br

# Opcional: em "1" / "true", respostas de erro incluem campo "detail" (use so para depurar).
# CONTACT_DIAGNOSTICS=1
